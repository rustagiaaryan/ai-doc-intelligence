apiVersion: v1
kind: Secret
metadata:
  name: ai-doc-secrets
  namespace: ai-doc-intelligence
type: Opaque
stringData:
  # Database Configuration
  # For AWS RDS PostgreSQL (Production):
  # DATABASE_URL: postgresql+asyncpg://username:password@your-rds-endpoint.rds.amazonaws.com:5432/docai
  #
  # For local development with self-hosted PostgreSQL:
  DATABASE_URL: postgresql+asyncpg://docai:docai_local_password@postgres:5432/docai

  # Local PostgreSQL credentials (only for local development)
  POSTGRES_USER: docai
  POSTGRES_PASSWORD: docai_local_password
  POSTGRES_DB: docai

  # AWS S3 Credentials (use AWS IAM user with S3 access)
  # For local development with MinIO, use: minioadmin/minioadmin
  S3_ACCESS_KEY_ID: "your-aws-access-key-id"  # AWS Access Key ID or minioadmin for local
  S3_SECRET_ACCESS_KEY: "your-aws-secret-access-key"  # AWS Secret Key or minioadmin for local

  # MinIO Credentials (only needed for local development)
  MINIO_ROOT_USER: minioadmin
  MINIO_ROOT_PASSWORD: minioadmin

  # JWT
  JWT_SECRET_KEY: your-secret-key-change-in-production

  # LLM API Keys (set these via kubectl or external secret management)
  OPENAI_API_KEY: "your-openai-api-key-here"
  ANTHROPIC_API_KEY: ""

  # Google OAuth
  GOOGLE_CLIENT_ID: "your-google-client-id.apps.googleusercontent.com"
  GOOGLE_CLIENT_SECRET: "your-google-client-secret"
